# Tratar binarios como binarios: sin conversión de fin de línea (CRLF) ni
# comprobaciones de whitespace. Evita corromper assets y exports.
*.png   binary
*.jpg   binary
*.jpeg  binary
*.gif   binary
*.webp  binary
*.ico   binary
*.pdf   binary
*.xlsx  binary
*.xls   binary
*.zip   binary
*.woff  binary
*.woff2 binary
*.ttf   binary
*.otf   binary
