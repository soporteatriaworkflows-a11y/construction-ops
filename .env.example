# Supabase
NEXT_PUBLIC_SUPABASE_URL=
# Clave PÚBLICA (publishable/anon). NO usar service_role en el frontend.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# (Compat) anon key heredada; equivalente a la publishable.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Solo server-side; NUNCA en el navegador ni como NEXT_PUBLIC_*.
SUPABASE_SERVICE_ROLE_KEY=

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Autenticación (Oleada 4A) — ver docs/AUTH_CONTRACT.md.
#   demo     = viewer demo server-side (solo dev/tests/demo sanitizada)
#   supabase = sesión real de Supabase Auth (obligatorio para operación real)
# Prohibido el fallback silencioso supabase->demo. Producción real != demo.
APP_AUTH_MODE=demo

# Database (Drizzle / PostgreSQL) — placeholder, sin credenciales reales
DATABASE_URL=postgresql://postgres:postgres@localhost:54322/postgres

# Read-model (Oleada 3A) — fuente de datos de las pantallas.
#   fixture = preview local desde el golden master sanitizado (recomendado dev)
#   db      = PostgreSQL local vía Drizzle (requiere DATABASE_URL; sin fallback)
READ_MODEL_SOURCE=fixture

# ---------------------------------------------------------------------------
# OPERATIONAL ACCESS + SMTP CORPORATIVO (OPERATIONAL_ACCESS_AND_SMTP_V1)
# Ver docs/OPERATIONAL_ACCESS_AND_SMTP_V1_CONTRACT.md §6. NINGÚN secreto se
# versiona ni se setea de forma remota desde el repo. Configurar SOLO en el
# entorno de despliegue (Vercel) y, para los correos de Supabase Auth (reset de
# contraseña), en el panel de Supabase → Auth → SMTP Settings.
# ---------------------------------------------------------------------------
# Base pública para construir enlaces de invitación (equivale a NEXT_PUBLIC_APP_URL).
APP_PUBLIC_URL=http://localhost:3000
# Proveedor de email de la app (invitaciones). Sin valor ⇒ auto: smtp si hay
# SMTP_* completas, de lo contrario `log` (captura en dev/test, NO envía real).
EMAIL_PROVIDER=
# SMTP corporativo (solo si EMAIL_PROVIDER=smtp o se quiere envío real).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
# NUNCA versionar la contraseña real; configurarla solo en el entorno.
SMTP_PASSWORD=
SMTP_FROM=
# true para 465 (SSL); false para 587 (STARTTLS). 465 fuerza secure aunque sea false.
SMTP_SECURE=false
# Vigencia de la invitación en horas (default 168 = 7 días).
INVITE_TTL_HOURS=168

# Price Monitoring Agent (Fase 4A) — ver docs/PRICE_MONITORING_AGENT_V1_CONTRACT.md.
# Secreto del cron (GET /api/cron/price-monitor). Vercel lo envía como
# Authorization: Bearer ${CRON_SECRET}. Sin valor ⇒ el endpoint responde 500
# seguro. Generar valor aleatorio >= 32 bytes SOLO en Vercel (Production);
# NUNCA versionar el valor real.
CRON_SECRET=
