# Supabase
NEXT_PUBLIC_SUPABASE_URL=
# Clave PÚBLICA (publishable/anon). NO usar service_role en el frontend.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# (Compat) anon key heredada; equivalente a la publishable.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Solo server-side; NUNCA en el navegador ni como NEXT_PUBLIC_*.
SUPABASE_SERVICE_ROLE_KEY=

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Autenticación (Oleada 4A) — ver docs/AUTH_CONTRACT.md.
#   demo     = viewer demo server-side (solo dev/tests/demo sanitizada)
#   supabase = sesión real de Supabase Auth (obligatorio para operación real)
# Prohibido el fallback silencioso supabase->demo. Producción real != demo.
APP_AUTH_MODE=demo

# Database (Drizzle / PostgreSQL) — placeholder, sin credenciales reales
DATABASE_URL=postgresql://postgres:postgres@localhost:54322/postgres

# Read-model (Oleada 3A) — fuente de datos de las pantallas.
#   fixture = preview local desde el golden master sanitizado (recomendado dev)
#   db      = PostgreSQL local vía Drizzle (requiere DATABASE_URL; sin fallback)
READ_MODEL_SOURCE=fixture

# Price Monitoring Agent (Fase 4A) — ver docs/PRICE_MONITORING_AGENT_V1_CONTRACT.md.
# Secreto del cron (GET /api/cron/price-monitor). Vercel lo envía como
# Authorization: Bearer ${CRON_SECRET}. Sin valor ⇒ el endpoint responde 500
# seguro. Generar valor aleatorio >= 32 bytes SOLO en Vercel (Production);
# NUNCA versionar el valor real.
CRON_SECRET=
